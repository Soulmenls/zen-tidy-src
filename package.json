{
  "name": "zen-tidy",
  "version": "0.1.0",
  "private": true,
  "description": "AI tab tidying for Zen Browser (Firefox WebExtension).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "export-tabs": "node scripts/export-tabs.mjs",
    "bench": "node scripts/bench.mjs",
    "tools": "npm ci --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org/ --prefix tools/web-ext",
    "lint:ext": "node scripts/web-ext.mjs lint --source-dir extension --self-hosted",
    "build:dev": "node scripts/build-dev.mjs",
    "gen:css": "node scripts/gen-css.mjs",
    "test:zen": "python test/integration/zen_flow.py",
    "test:sidebar": "python test/integration/zen_sidebar.py",
    "test:update": "python test/integration/zen_update.py",
    "test:release": "python test/integration/zen_release.py",
    "release": "node scripts/release.mjs",
    "hooks": "node scripts/install-hooks.mjs"
  }
}
